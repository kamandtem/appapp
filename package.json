{
  "name": "atelito",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android:add": "cap add android",
    "android:sync": "cap sync android && node scripts/android-permissions.mjs",
