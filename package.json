    "android:permissions": "node scripts/android-permissions.mjs",
    "import-pose-pack": "node scripts/import-pose-pack.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.2.0",
